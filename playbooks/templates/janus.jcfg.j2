# /etc/janus/janus.jcfg - Згенеровано Ansible для RFA на Ubuntu 24.04
general: {
    configs_folder = "/etc/janus"
    plugins_folder = "/usr/lib/x86_64-linux-gnu/janus/plugins"
    transports_folder = "/usr/lib/x86_64-linux-gnu/janus/transports"
    events_folder = "/usr/lib/x86_64-linux-gnu/janus/events"
    loggers_folder = "/usr/lib/x86_64-linux-gnu/janus/loggers"
    
    token_auth = true
    admin_secret = "{{ janus_admin_secret }}"
}

nat: {
    stun_server = "{{ coturn_realm }}"
    stun_port = 3478
    
    turn_server = "{{ coturn_realm }}"
    turn_port = 3478
    turn_type = "udp"
    turn_secret = "{{ coturn_static_secret }}"
}

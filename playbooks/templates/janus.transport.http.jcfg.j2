# /etc/janus/janus.transport.http.jcfg - Згенеровано Ansible для RFA
general: {
    json = "indented"
    base_path = "/janus"
    http = true
    port = 8055
    interface = "0.0.0.0"
    https = false
}

admin: {
    admin_base_path = "/admin"
    admin_http = true
    admin_port = 7055
    admin_interface = "0.0.0.0"
}